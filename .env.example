# 백엔드가 같은 도메인에서 /api/v1로 제공되면 비워두어도 됩니다.
# 별도 서버라면 origin과 /api/v1을 함께 입력하세요.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 운영 환경에서 체험용 로그인을 명시적으로 표시할 때만 true로 설정하세요.
# 개발 환경에서는 설정하지 않아도 체험용 로그인 버튼이 표시됩니다.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# 브라우저에 설치된 특정 TTS 음성을 우선 사용하고 싶을 때 이름 일부를 입력하세요.
# 예: Samantha, Ava, Microsoft Aria, Google US English
NEXT_PUBLIC_TTS_VOICE_NAME=
